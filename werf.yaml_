project: voip-gui
configVersion: 1

---
image: voip_gui
from: ubuntu:16.04

docker:
  WORKDIR: /opt/voip_gui
  USER: apache
  ENV:
    APACHE_RUN_USER: apache
    APACHE_RUN_GROUP: apache
    APACHE_LOG_DIR: /var/log/apache2
    APACHE_LOCK_DIR: /var/lock/apache2
    APACHE_PID_FILE: /var/run/apache2.pid
    LC_ALL: en_US.UTF-8
  CMD: ["/usr/sbin/apache2ctl", "-D FOREGROUND"]
#  CMD: ["/bin/sleep","infinity"]
  EXPOSE: "8080"

git:
- add: /
  to: /opt/voip_gui
  owner: apache
  group: apache

ansible:
  beforeInstall:
  - name: "Install additional packages"
    apt:
      state: present
      update_cache: yes
      pkg:
        - locales
        - ca-certificates
  - name: "Generate en_US.UTF-8 default locale"
    locale_gen:
      name: en_US.UTF-8
      state: present
  - name: "Create non-root group for the main application"
    group:
      name: apache
      state: present
      gid: 242
  - name: "Create non-root user for the main application"
    user:
      name: apache
      comment: "Create non-root user for the main application"
      uid: 242
      group: apache
      shell: /bin/bash
      home: /opt/voip_gui
  - name: Add repository key
    apt_key:
      keyserver: keyserver.ubuntu.com
      id: E5267A6C
  - name: "Add PHP apt repository"
    apt_repository:
      repo: 'deb http://ppa.launchpad.net/ondrej/php/ubuntu xenial main'
      update_cache: yes
  - name: "Install PHP and modules"
    apt:
      name: "{{`{{ packages }}`}}"
      state: present
      update_cache: yes
    vars:
      packages:
        - apache2
        - mc
        - wget
        - unzip
        - tar
        - php5.6
        - php5.6-cli
        - php5.6-curl
        - php5.6-gd
        - php5.6-json
        - php5.6-mcrypt
        - php5.6-pgsql
        - php5.6-readline
        - php5.6-xdebug
        - php5.6-xmlrpc
        - php5.6-mbstring
        - php5.6-dom
        - php5.6-zip
  - name: Install composer
    get_url:
      url: https://getcomposer.org/download/1.10.7/composer.phar
      dest: /usr/local/bin/composer
      mode: a+x
  install:
  - name: "Install global require"
    shell: composer global require "fxp/composer-asset-plugin"
    become: yes
    become_user: apache
    args:
      chdir: /opt/voip_gui
      creates: /opt/voip_gui/vendor/

  - name: "Install app deps"
#    # NOTICE: Always use `composer install` command in real world environment!
    shell: composer install
    become: yes
    become_user: apache
    args:
      chdir: /opt/voip_gui
      creates: /opt/voip_gui/vendor/
  setup:
  - name: ""
    shell: a2enmod rewrite \
           && whoami && pwd && chown -R apache:apache /opt/voip_gui/web \
           &&  mkdir -p /var/log/apache2 && chown -R apache:apache /var/log/apache2 \
           &&  mkdir -p /var/run/apache2 && chown -R apache:apache /var/run/apache2 \
           &&  chmod 777 /opt/voip_gui/runtime \
           &&  chmod 777 /opt/voip_gui/web/assets \
           &&  cp -pf \
                /etc/apache2/apache2.conf \
                /etc/apache2/apache2.conf.default \
           && sed -i \
                -e '/^Listen .*$/d' \
                /etc/apache2/ports.conf \
           && { \
                echo 'Listen 8080'; \
              } >> /etc/apache2/ports.conf
           && sed -i \
                -e '/^KeepAlive .*$/d' \
                -e '/^MaxKeepAliveRequests .*$/d' \
                -e '/^KeepAliveTimeout .*$/d' \
                -e '/^ServerSignature On$/d' \
                -e '/^ServerTokens OS$/d' \
                /etc/apache2/apache2.conf \
           && { \
                echo ''; \
                echo '#'; \
                echo '# Custom configuration'; \
                echo '#'; \
                echo 'ServerName voip_gui:80'; \
                echo 'KeepAlive On'; \
                echo 'MaxKeepAliveRequests 200'; \
                echo 'KeepAliveTimeout 2'; \
                echo 'DocumentRoot "/opt/voip_gui/web"'; \
                echo '<Directory "/opt/voip_gui/web">'; \
                echo '  AllowOverride All'; \
                echo '  Require all granted'; \
                echo ''; \
                echo '</Directory>'; \
              } >> /etc/apache2/apache2.conf
    become: yes
    become_user: root
    args:
       chdir: /opt/voip_gui

