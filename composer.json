{
  "type": "project",
  "minimum-stability": "dev",
  "require": {
    "php": ">=5.5.0",
    "yiisoft/yii2": "2.0.3",
    "graylog2/gelf-php": "*"
  },
  "config": {
    "process-timeout": 1800
  },
  "extra": {
    "writable": [
      "runtime",
      "web/assets"
    ],
    "executable": [
      "yii"
    ],
    "asset-installer-paths": {
      "npm-asset-library": "vendor/npm",
      "bower-asset-library": "vendor/bower"
    }
  }
}
