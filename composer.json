{
	"type": "project",
	"minimum-stability": "dev",
	"require": {
		"php": ">=5.4.0",
		"yiisoft/yii2": "2.0.x-dev",
		"graylog2/gelf-php": "*"
	},
	"require-dev": {
		"yiisoft/yii2-codeception": "2.0.x-dev",
		"yiisoft/yii2-faker": "2.0.x-dev"
	},
	"config": {
		"process-timeout": 1800
	},
	"extra": {
		"writable": [
			"runtime",
			"web/assets"
		],
		"executable": [
			"yii"
		],
        "asset-installer-paths": {
            "npm-asset-library": "vendor/npm",
            "bower-asset-library": "vendor/bower"
        }
	}
}
