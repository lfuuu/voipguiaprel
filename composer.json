{
  "type": "project",
  "minimum-stability": "dev",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/welltime/amazon-s3-php-class"
    }
  ],
  "require": {
    "php": ">=7.4.0",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "yiisoft/yii2": ">=2.0.14.2",
    "graylog2/gelf-php": "*",
    "kartik-v/yii2-widget-select2": "@dev",
    "phpoffice/phpspreadsheet": "1.8.2",
    "tpyo/amazon-s3-php-class": "dev-mcn"
  },
  "config": {
    "process-timeout": 1800
  },
  "extra": {
    "writable": [
      "runtime",
      "web/assets"
    ],
    "executable": [
      "yii"
    ],
    "asset-installer-paths": {
      "npm-asset-library": "vendor/npm",
      "bower-asset-library": "vendor/bower"
    }
  }
}
